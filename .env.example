# =============================================================================
# CRYPTO PORT — 環境変数のひな形
#
# このファイルをコピーして .env.local を作ってください。
#   cp .env.example .env.local
#
# ■ 重要
#   NEXT_PUBLIC_ が付いた変数は **ブラウザに配信されます**。
#   APIキー・シークレットには絶対に NEXT_PUBLIC_ を付けないでください。
#
# ■ すべて未設定でも動きます
#   市場データはモック、ニュースはサンプル、アフィリエイトは通常リンクとして
#   動作し、画面上でもその旨が表示されます。
# =============================================================================


# -----------------------------------------------------------------------------
# ブランド（サイト名・ロゴ・ドメインの差し替え）
# 仮名のまま開発できるよう、すべて環境変数化してあります。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PORTAL_NAME="CRYPTO PORT"
NEXT_PUBLIC_PORTAL_SHORT_NAME="CryptoPort"
# 例: /images/portal/logo.svg（未設定ならCSSのワードマークを使います）
NEXT_PUBLIC_PORTAL_LOGO=""
NEXT_PUBLIC_PORTAL_PUBLISHER="CRYPTO PORT 編集部"
NEXT_PUBLIC_PORTAL_EMAIL=""

# 公開URL（末尾スラッシュなし）。canonical / hreflang / OGP / サイトマップの基準になります
NEXT_PUBLIC_PORTAL_URL="https://crypto-port.example.com"

# サブディレクトリ配信をするとき（GitHub Pages のプロジェクトページ等）
# NEXT_PUBLIC_BASE_PATH="/yakiniku-senri"


# -----------------------------------------------------------------------------
# SNS（設定した分だけフッターに表示されます。空欄は出ません）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PORTAL_X=""
NEXT_PUBLIC_PORTAL_YOUTUBE=""
NEXT_PUBLIC_PORTAL_LINE=""
NEXT_PUBLIC_PORTAL_DISCORD=""
NEXT_PUBLIC_PORTAL_NEWSLETTER=""


# -----------------------------------------------------------------------------
# 市場データ
#
# 既定は mock。実データに切り替えるときだけ coingecko にしてください。
# API は必ずサーバー側（src/portal/lib/market.ts）から呼ばれます。
# -----------------------------------------------------------------------------
MARKET_DATA_SOURCE="mock"          # mock | coingecko

# ⚠ NEXT_PUBLIC_ を付けないこと（クライアントに漏れます）
COINGECKO_API_KEY=""
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"

# サーバー側キャッシュの秒数。無料枠のレート制限を踏まえて長めにします
MARKET_REVALIDATE_SEC="60"

# ティッカーをブラウザから定期更新するか。
# true にすると /api/market を refreshIntervalSec ごとに叩きます。
# 静的書き出し（GitHub Pages）では既定の false のままを推奨します。
NEXT_PUBLIC_MARKET_POLLING="false"

# 円建て表示に使う為替レート。未設定（0）のあいだは日本語でもドル表示のままにします。
# 推測値で円に換算すると誤情報になるためです。
NEXT_PUBLIC_USD_JPY="0"


# -----------------------------------------------------------------------------
# 静的書き出し（GitHub Pages 等）
#
# 13言語 × 全ページを静的化するとページ数が1,000を超えビルドが長くなるため、
# 静的書き出しのときは既定で ja / en に絞ります。
# -----------------------------------------------------------------------------
# PORTAL_STATIC_LOCALES="ja,en,ko,zh-cn"


# -----------------------------------------------------------------------------
# アフィリエイトリンク
#
# 未設定のあいだは公式サイトへの通常リンクになり、「PR」表記も出ません
# （広告でないものを広告と表示しないため）。
# 設定すると rel="sponsored nofollow noopener" とPR表記が付きます。
#
# 新しいプログラムを追加するときは、src/portal/lib/affiliate.ts の
# affiliateLinks と affiliateEnv の両方に1行ずつ足してください。
# （process.env は動的キーで読めないため、明示的な列挙が必要です）
# -----------------------------------------------------------------------------
AFF_BITBANK=""
AFF_BITFLYER=""
AFF_COINCHECK=""
AFF_GMO_COIN=""
AFF_SBI_VC=""


# -----------------------------------------------------------------------------
# メール登録
#
# 未設定のあいだは送信せず「送信できません」と表示します。
# 登録できたように見せて実際には届いていない状態を避けるためです。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=""


# -----------------------------------------------------------------------------
# AIチャットボット（任意）
#
# 未設定でも、サイト内コンテンツからの抽出型で完全に動作します。
# 生成モデルを使う場合はサーバー実行環境が必要です（README「AIチャットボット」参照）。
# ⚠ NEXT_PUBLIC_ を付けないこと
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""


# -----------------------------------------------------------------------------
# 将来の拡張（未実装。docs/DATABASE.md のスキーマに対応）
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""      # ⚠ サーバー専用。絶対に公開しないこと


# =============================================================
# SPORTS PORT（スポーツポータル / "/ja/" "/en/" …）
# =============================================================

# -------------------------------------------------------------
# ブランド設定
#   ここを変えるだけで、サイト名・ロゴ・ドメインが全ページに反映されます。
#   より細かい設定（カラー・機能フラグ）は src/sports/config/site.ts です。
# -------------------------------------------------------------
NEXT_PUBLIC_SPORTS_SITE_NAME=SPORTS PORT
NEXT_PUBLIC_SPORTS_ORIGIN=https://sportsport.example
# ロゴのモノグラム（画像ロゴを使う場合は LOGO_SRC を設定）
NEXT_PUBLIC_SPORTS_LOGO_MARK=SP
# NEXT_PUBLIC_SPORTS_LOGO_SRC=/images/sports/logo.svg

# -------------------------------------------------------------
# データソース
#   mock : 同梱のモックデータを使う（APIキー不要。既定値）
#   live : 外部APIから取得する（下のキーが必要）
# -------------------------------------------------------------
SPORTS_DATA_SOURCE=mock

# ライブスコアのポーリング間隔（秒）
#   画面に表示する「更新間隔」と同じ値が使われます。
#   実際のAPIの更新頻度より短くしないでください（古い情報を新しく見せることになります）。
NEXT_PUBLIC_SPORTS_LIVE_REFRESH_SEC=30

# -------------------------------------------------------------
# 外部API（サーバー側のみ。NEXT_PUBLIC_ を付けないこと）
#   src/sports/lib/api.ts の fetchWithGuards() に渡して使います。
# -------------------------------------------------------------
# 試合・順位・スタッツ
# SPORTS_API_FOOTBALL_KEY=
# SPORTS_API_FOOTBALL_BASE_URL=https://api.example.com/v3
# SPORTS_API_BASKETBALL_KEY=
# SPORTS_API_BASEBALL_KEY=

# ニュース（RSS / API）
# SPORTS_NEWS_API_KEY=
# SPORTS_NEWS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml

# YouTube Data API（未設定ならモック動画を表示します）
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_IDS=

# -------------------------------------------------------------
# データベース / キャッシュ（将来の移行先）
#   現在はファイルベース（src/sports/data/*.ts）で動作します。
# -------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# REDIS_URL=

# -------------------------------------------------------------
# 機能フラグ
# -------------------------------------------------------------
# ベッティング情報ページを丸ごと落とす場合は false
NEXT_PUBLIC_SPORTS_ENABLE_BETTING=true

# -------------------------------------------------------------
# SNS / 会員導線（実アカウントが決まるまでは空のままにしてください）
#   推測のURLを置くと、存在しないページへ誘導することになります。
# -------------------------------------------------------------
# NEXT_PUBLIC_SPORTS_YOUTUBE_URL=
# NEXT_PUBLIC_SPORTS_X_URL=
# NEXT_PUBLIC_SPORTS_INSTAGRAM_URL=
# NEXT_PUBLIC_SPORTS_LINE_URL=
# NEXT_PUBLIC_SPORTS_NEWSLETTER_URL=

# -------------------------------------------------------------
# デモデータの基準日（通常は設定不要）
#   未設定ならビルド日（UTC 0時に丸めた値）が自動で入ります。
#   next.config.ts が埋め込むため、手動設定はデバッグ用途のみです。
# -------------------------------------------------------------
# NEXT_PUBLIC_SPORTS_REFERENCE_DAY=2026-08-04T00:00:00.000Z
