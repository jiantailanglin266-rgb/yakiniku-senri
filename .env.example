# AI PORT の配信オリジン（スキーム＋ホストまで）。
# ⚠ リポジトリ名（/ai-port）は入れないでください。
#   絶対URLは NEXT_PUBLIC_BASE_PATH と連結して組み立てるため、
#   ここにも入れると /ai-port/ai-port/... と二重になります。
NEXT_PUBLIC_AI_PORT_URL=https://jiantailanglin266-rgb.github.io

# サブディレクトリ配信のベースパス。GitHub Actions が自動で渡すため、
# ローカル開発では設定しません（未設定なら http://localhost:3000/ で開きます）。
# NEXT_PUBLIC_BASE_PATH=/ai-port
