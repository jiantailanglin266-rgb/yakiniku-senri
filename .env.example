# =============================================================
# 環境変数サンプル
#
#   cp .env.example .env.local
#
# ここに書かれた値がなくても、サイトは全ページ動作します
# （SPORTS PORT は同梱のモックデータで動く前提で作られています）。
#
# ⚠ NEXT_PUBLIC_ が付く変数はブラウザへ露出します。
#   APIキー・シークレットには絶対に付けないでください。
# =============================================================

# -------------------------------------------------------------
# 焼肉 千里（既存サイト / ルート "/"）
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yakinikusenri.com
# NEXT_PUBLIC_SITE_NAME=焼肉 千里
# NEXT_PUBLIC_PHONE_NUMBER=03-0000-0000
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_GOOGLE_MAPS_URL=

# サブディレクトリ配信（GitHub Pages のプロジェクトページなど）
# NEXT_PUBLIC_BASE_PATH=/yakiniku-senri


# =============================================================
# SPORTS PORT（スポーツポータル / "/ja/" "/en/" …）
# =============================================================

# -------------------------------------------------------------
# ブランド設定
#   ここを変えるだけで、サイト名・ロゴ・ドメインが全ページに反映されます。
#   より細かい設定（カラー・機能フラグ）は src/sports/config/site.ts です。
# -------------------------------------------------------------
NEXT_PUBLIC_SPORTS_SITE_NAME=SPORTS PORT
NEXT_PUBLIC_SPORTS_ORIGIN=https://sportsport.example
# ロゴのモノグラム（画像ロゴを使う場合は LOGO_SRC を設定）
NEXT_PUBLIC_SPORTS_LOGO_MARK=SP
# NEXT_PUBLIC_SPORTS_LOGO_SRC=/images/sports/logo.svg

# -------------------------------------------------------------
# データソース
#   mock : 同梱のモックデータを使う（APIキー不要。既定値）
#   live : 外部APIから取得する（下のキーが必要）
# -------------------------------------------------------------
SPORTS_DATA_SOURCE=mock

# ライブスコアのポーリング間隔（秒）
#   画面に表示する「更新間隔」と同じ値が使われます。
#   実際のAPIの更新頻度より短くしないでください（古い情報を新しく見せることになります）。
NEXT_PUBLIC_SPORTS_LIVE_REFRESH_SEC=30

# -------------------------------------------------------------
# 外部API（サーバー側のみ。NEXT_PUBLIC_ を付けないこと）
#   src/sports/lib/api.ts の fetchWithGuards() に渡して使います。
# -------------------------------------------------------------
# 試合・順位・スタッツ
# SPORTS_API_FOOTBALL_KEY=
# SPORTS_API_FOOTBALL_BASE_URL=https://api.example.com/v3
# SPORTS_API_BASKETBALL_KEY=
# SPORTS_API_BASEBALL_KEY=

# ニュース（RSS / API）
# SPORTS_NEWS_API_KEY=
# SPORTS_NEWS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml

# YouTube Data API（未設定ならモック動画を表示します）
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_IDS=

# -------------------------------------------------------------
# データベース / キャッシュ（将来の移行先）
#   現在はファイルベース（src/sports/data/*.ts）で動作します。
# -------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# REDIS_URL=

# -------------------------------------------------------------
# 機能フラグ
# -------------------------------------------------------------
# ベッティング情報ページを丸ごと落とす場合は false
NEXT_PUBLIC_SPORTS_ENABLE_BETTING=true

# -------------------------------------------------------------
# SNS / 会員導線（実アカウントが決まるまでは空のままにしてください）
#   推測のURLを置くと、存在しないページへ誘導することになります。
# -------------------------------------------------------------
# NEXT_PUBLIC_SPORTS_YOUTUBE_URL=
# NEXT_PUBLIC_SPORTS_X_URL=
# NEXT_PUBLIC_SPORTS_INSTAGRAM_URL=
# NEXT_PUBLIC_SPORTS_LINE_URL=
# NEXT_PUBLIC_SPORTS_NEWSLETTER_URL=

# -------------------------------------------------------------
# デモデータの基準日（通常は設定不要）
#   未設定ならビルド日（UTC 0時に丸めた値）が自動で入ります。
#   next.config.ts が埋め込むため、手動設定はデバッグ用途のみです。
# -------------------------------------------------------------
# NEXT_PUBLIC_SPORTS_REFERENCE_DAY=2026-08-04T00:00:00.000Z
