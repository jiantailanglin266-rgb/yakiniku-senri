# =============================================================================
# 焼肉 千里 — 環境変数のひな形
#
# このファイルをコピーして .env.local を作ってください。
#   cp .env.example .env.local
#
# ■ 重要
#   NEXT_PUBLIC_ が付いた変数は **ブラウザに配信されます**。
#   APIキー・シークレットには絶対に NEXT_PUBLIC_ を付けないでください。
#
# ■ すべて未設定でも動きます
#   未設定の項目は src/data/store.ts の値が使われます。
# =============================================================================

# 公開URL（末尾スラッシュなし）。canonical / OGP / サイトマップの基準になります
NEXT_PUBLIC_SITE_URL="https://yakinikusenri.com"

# サイト名。未設定なら店舗名（src/data/store.ts）を使います
NEXT_PUBLIC_SITE_NAME=""

# サブディレクトリ配信をするとき（GitHub Pages のプロジェクトページ等）
# NEXT_PUBLIC_BASE_PATH="/yakiniku-senri"

# -----------------------------------------------------------------------------
# 店舗情報の上書き（未設定なら src/data/store.ts の値）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PHONE_NUMBER=""
NEXT_PUBLIC_GOOGLE_MAPS_URL=""

# -----------------------------------------------------------------------------
# 外部リンク（公開前に実際のアカウントをご確認ください）
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TABELOG_URL=""

# -----------------------------------------------------------------------------
# お問い合わせ / 計測
# -----------------------------------------------------------------------------
# ⚠ NEXT_PUBLIC_ を付けないこと（サーバー側でのみ使います）
CONTACT_EMAIL=""

NEXT_PUBLIC_GA_ID=""
