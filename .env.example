# CRYPTO PORT の配信オリジン（スキーム＋ホストまで）。
# ⚠ リポジトリ名（/crypto-port）は入れないでください。
#   portalBase = このURL + NEXT_PUBLIC_BASE_PATH で組み立てるため、
#   ここにも入れると /crypto-port/crypto-port/... と二重になります。
NEXT_PUBLIC_PORTAL_URL=https://jiantailanglin266-rgb.github.io

# サブディレクトリ配信のベースパス。GitHub Actions が自動で渡すため、
# ローカル開発では設定しません。
# NEXT_PUBLIC_BASE_PATH=/crypto-port

# 相場データの定期取得（既定は無効。サーバー配信時のみ有効にできます）
# NEXT_PUBLIC_MARKET_POLLING=false
