# =====================================================================
# 環境変数サンプル
#
#   cp .env.example .env.local
#
# このリポジトリは2つのサイトを1つの Next.js アプリで配信します。
#   - 焼肉 千里（既存）        … / 直下
#   - CARD PORT（フィンテック）… /<言語コード>/ 配下
# それぞれ別ドメインでも、同じドメインに同居させても動きます。
# =====================================================================


# ---------------------------------------------------------------------
# 共通
# ---------------------------------------------------------------------

# サブディレクトリ配信（GitHub Pages のプロジェクトページ等）のベースパス。
# 独自ドメインの本番では空のままにしてください。
NEXT_PUBLIC_BASE_PATH=


# ---------------------------------------------------------------------
# 焼肉 千里（既存サイト）
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://yakinikusenri.com
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TABELOG_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
CONTACT_EMAIL=
NEXT_PUBLIC_GA_ID=


# ---------------------------------------------------------------------
# CARD PORT — サイト identity
#
# サイト名・ロゴ・ドメインは、ここだけで差し替えられます。
# コンポーネントにこれらの値を直接書かないでください。
# ---------------------------------------------------------------------
NEXT_PUBLIC_CARDPORT_URL=https://cardport.example
NEXT_PUBLIC_CARDPORT_NAME=CARD PORT
NEXT_PUBLIC_CARDPORT_SHORT_NAME=CARD PORT

# ロゴのワードマーク。2語に分けてグラデーションを掛け分けます
NEXT_PUBLIC_CARDPORT_WORDMARK_LEAD=CARD
NEXT_PUBLIC_CARDPORT_WORDMARK_TAIL=PORT


# ---------------------------------------------------------------------
# CARD PORT — ブランドカラー
#
# 未設定なら既定のパレットが使われます。
# ここを変えるとサイト全体の配色（背景・ボタン・グラデーション）が追随します。
# ---------------------------------------------------------------------
NEXT_PUBLIC_CARDPORT_COLOR_BASE=#05070f
NEXT_PUBLIC_CARDPORT_COLOR_SURFACE=#0b1020
NEXT_PUBLIC_CARDPORT_COLOR_CYAN=#22d3ee
NEXT_PUBLIC_CARDPORT_COLOR_ELECTRIC=#3b82f6
NEXT_PUBLIC_CARDPORT_COLOR_VIOLET=#8b5cf6
NEXT_PUBLIC_CARDPORT_COLOR_MAGENTA=#e548a8
NEXT_PUBLIC_CARDPORT_COLOR_EMERALD=#34d399
NEXT_PUBLIC_CARDPORT_COLOR_GOLD=#e3c37a


# ---------------------------------------------------------------------
# CARD PORT — 運営会社情報
#
# ⚠ 公開前に必ず実在の情報を入れてください。
#   未設定の項目は「未設定」と画面に表示されます（推測値を入れない方針のため）。
# ---------------------------------------------------------------------
NEXT_PUBLIC_CARDPORT_COMPANY=
NEXT_PUBLIC_CARDPORT_REPRESENTATIVE=
NEXT_PUBLIC_CARDPORT_ESTABLISHED=
NEXT_PUBLIC_CARDPORT_ADDRESS=
NEXT_PUBLIC_CARDPORT_EMAIL=
NEXT_PUBLIC_CARDPORT_REGISTRATION=


# ---------------------------------------------------------------------
# CARD PORT — 外部チャネル（空のものはUIに出ません）
# ---------------------------------------------------------------------
NEXT_PUBLIC_CARDPORT_YOUTUBE=
NEXT_PUBLIC_CARDPORT_X=
NEXT_PUBLIC_CARDPORT_LINE=
NEXT_PUBLIC_CARDPORT_INSTAGRAM=
NEXT_PUBLIC_CARDPORT_NEWSLETTER=


# ---------------------------------------------------------------------
# CARD PORT — データソース
#
#   mock … 同梱の架空データを表示（既定）
#   live … 外部データを参照（Supabase 等。README の「本番データへの切り替え」参照）
# ---------------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE=mock

# アフィリエイト計測に付与するサイト識別子（utm_source）
NEXT_PUBLIC_AFFILIATE_SITE_ID=cardport

# 詳細ページを生成する言語（カンマ区切り）。
# 未設定なら全14言語。GITHUB_PAGES=true のときは ja,en に自動で絞られます。
CARDPORT_CONTENT_LOCALES=


# ---------------------------------------------------------------------
# CARD PORT — 外部API（未設定でもモックで全機能が動きます）
# ---------------------------------------------------------------------

# YouTube Data API。未設定なら src/cardport/data/videos.ts のモックを表示します
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# AIチャットボットを生成モデルへ接続する場合のエンドポイント。
# 未設定なら掲載データを検索して返す方式で動きます（APIキー不要）。
# ⚠ APIキーはクライアントへ出さないでください。必ずサーバー側で保持します。
NEXT_PUBLIC_CHAT_API_URL=
ANTHROPIC_API_KEY=

# Supabase（本番データ・管理画面の認証を有効化する場合）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠ service_role キーは NEXT_PUBLIC_ を付けないこと。サーバー専用です
SUPABASE_SERVICE_ROLE_KEY=
