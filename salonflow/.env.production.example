# ---------------------------------------------------------------------------
# SalonFlow — self-hosted production settings
#
#   cp .env.production.example .env
#
# This file is read by docker-compose.yml. Never commit the filled-in .env.
# ---------------------------------------------------------------------------

# --- 必須 -------------------------------------------------------------------

# PostgreSQL のパスワード。推測されない値にしてください。
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# セッション署名と、カルテ写真の署名付きURLに使う鍵。32文字以上。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 変更すると全セッションが無効化され、発行済みの署名付きURLも失効します。
SESSION_SECRET=

# --- HTTPS で公開する場合 ---------------------------------------------------
# docker compose --profile https up -d で Caddy が自動的に証明書を取得します。
# 事前に DNS の A レコードをこのサーバーへ向けておいてください。
DOMAIN=salon.example.com
APP_URL=https://salon.example.com

# HTTPS を使わない場合（ローカル検証など）はこちら。
# APP_URL=http://localhost:3100

# --- 初回セットアップ -------------------------------------------------------
# docker compose run --rm bootstrap が参照します。
# 最初の法人・店舗・オーナーアカウントを 1 度だけ作成します。
# デモ顧客やサンプル予約は作られません。
#
# オーナーがログインできたら、BOOTSTRAP_ADMIN_PASSWORD は .env から削除して
# ください。サーバー上の平文パスワードを残す理由はありません。

BOOTSTRAP_ORG_NAME=
BOOTSTRAP_STORE_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# 12文字以上。よくあるパスワードは拒否されます。
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
BOOTSTRAP_ADMIN_PASSWORD=

# 省略すると名前から自動生成されます。
# BOOTSTRAP_STORE_SLUG は公開予約ページの URL（/booking/〇〇）になります。
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_STORE_SLUG=

# hair / nail / eyelash / esthetic / relaxation のいずれか。
BOOTSTRAP_INDUSTRY=hair

# --- 任意 -------------------------------------------------------------------

POSTGRES_USER=salonflow
POSTGRES_DB=salonflow

PRODUCT_NAME=SalonFlow
DEFAULT_TIMEZONE=Asia/Tokyo
LOG_LEVEL=info

# 本番では false。true にすると「デモデータです」のバナーが全画面に出ます。
DEMO_MODE=false

# Caddy を使う場合、アプリをホストに直接公開する必要はありません。
# 127.0.0.1 のままにしておくと外部から 3100 番へ直接アクセスできません。
APP_BIND=127.0.0.1

# 通知配送の実行間隔（秒）。
JOB_INTERVAL_SECONDS=300

# --- メール送信 -------------------------------------------------------------
# console = 送信しない（ログに出力するだけ）
# file    = 送信しない（.mailbox/ に書き出す）
# smtp    = 実際に送信する
#
# 予約確認とリマインドを顧客に届けるには smtp が必要です。
# 設定後、必ず `npm run mail:check -- あなたのアドレス` で確認してください。
MAIL_TRANSPORT=console

# 送信元。ドメイン認証（SPF / DKIM / DMARC）を済ませたドメインを使ってください。
# 未認証だと迷惑メール扱いされ、リマインドが届きません。
MAIL_FROM=SalonFlow <no-reply@salon.example.com>

# 契約したメール送信事業者の SMTP 情報。
# 多くの事業者はパスワードではなく API キーを SMTP_PASSWORD に入れます。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- バックアップ -----------------------------------------------------------
# scripts/backup.sh が参照します。
BACKUP_DIR=./backups
RETAIN_DAILY=30
RETAIN_MONTHLY=12
