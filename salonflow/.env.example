# ---------------------------------------------------------------------------
# SalonFlow environment variables
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL 14+ with the `btree_gist` extension available.
DATABASE_URL="postgresql://salonflow:salonflow@localhost:5432/salonflow?schema=public"
# Direct (non-pooled) connection. REQUIRED — Prisma uses it for migrations,
# which cannot run through a transaction-mode pooler such as PgBouncer.
# Locally, set it to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://salonflow:salonflow@localhost:5432/salonflow?schema=public"

# --- Session / crypto (required) -------------------------------------------
# Minimum 32 characters. Rotating this invalidates every active session.
SESSION_SECRET="change-me-to-a-random-32-plus-character-string"
# Session lifetime in seconds (default 12 hours).
SESSION_TTL_SECONDS="43200"
# Days of inactivity after which an idle session is revoked.
SESSION_IDLE_DAYS="7"

# --- Product branding ------------------------------------------------------
# The product name is never hardcoded; change it here.
PRODUCT_NAME="SalonFlow"
PRODUCT_SUPPORT_EMAIL="support@example.invalid"
# Public origin used to build absolute URLs in notifications.
APP_URL="http://localhost:3100"

# --- Localisation ----------------------------------------------------------
DEFAULT_LOCALE="ja"
DEFAULT_TIMEZONE="Asia/Tokyo"
DEFAULT_CURRENCY="JPY"

# --- Notifications ---------------------------------------------------------
# Transport for outgoing email. One of: console | file | smtp
# `console` and `file` DO NOT send real mail. They are development
# placeholders. `smtp` requires a real, contracted mail provider.
MAIL_TRANSPORT="console"
MAIL_FROM="SalonFlow <no-reply@example.invalid>"
# Only used when MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=".mailbox"
# Only used when MAIL_TRANSPORT=smtp.
# Port 465 uses implicit TLS; 587 and 25 require STARTTLS. Most providers
# expect an API key in SMTP_PASSWORD rather than an account password.
# Verify before customers depend on it:  npm run mail:check -- you@example.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# SMS / LINE / Web Push are NOT implemented in Phase 1.
# These keys exist so that deployment configuration can be prepared, but the
# application will refuse to send until the corresponding adapter is built.
SMS_PROVIDER=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --- Storage ---------------------------------------------------------------
# One of: local | s3   (Phase 1 implements `local` only)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
# Signed URL lifetime for medical-record photos, in seconds.
STORAGE_SIGNED_URL_TTL="300"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments (NOT connected in Phase 1) -----------------------------------
# Card data is never stored in this database. Only provider tokens are kept.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Jobs ------------------------------------------------------------------
# Phase 1 runs jobs in-process. Phase 3 switches to BullMQ + Redis.
JOB_DRIVER="inline"
REDIS_URL=""

# --- Security --------------------------------------------------------------
# Failed sign-in attempts before the account is temporarily locked.
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCK_MINUTES="15"
# Requests per minute per IP for public (unauthenticated) endpoints.
RATE_LIMIT_PUBLIC_PER_MINUTE="60"
RATE_LIMIT_AUTH_PER_MINUTE="10"

# --- Observability ---------------------------------------------------------
LOG_LEVEL="info"
SENTRY_DSN=""

# --- Demo data -------------------------------------------------------------
# When true the UI displays a banner clarifying that all data is fictional.
DEMO_MODE="true"
DEMO_ADMIN_EMAIL="owner@demo.example.invalid"
DEMO_ADMIN_PASSWORD="DemoPassw0rd!"

# --- First-run bootstrap (real tenant, no demo data) ------------------------
# Read by `npm run db:bootstrap`, which creates the permission catalogue, the
# standard roles, one organization, one store and one owner account — and
# nothing else. Distinct from `npm run db:seed`, which inserts fictional
# customers and bookings for demonstration.
#
# Safe to re-run: an existing organization is left untouched.
BOOTSTRAP_ORG_NAME=""
BOOTSTRAP_STORE_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
# 12+ characters. Common passwords are rejected.
BOOTSTRAP_ADMIN_PASSWORD=""
# Derived from the names when left empty. The store slug becomes the public
# booking URL (/booking/<slug>).
BOOTSTRAP_ORG_SLUG=""
BOOTSTRAP_STORE_SLUG=""
# hair | nail | eyelash | esthetic | relaxation
BOOTSTRAP_INDUSTRY="hair"
